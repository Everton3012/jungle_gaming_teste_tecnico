APP_ENV=development
APP_PORT=8080

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jungle_gaming
POSTGRES_USER=jungle
POSTGRES_PASSWORD=jungle

DATABASE_URL=postgres://jungle:jungle@postgres:5432/jungle_gaming?sslmode=disable

HTTP_ADDRESS=:8080

DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_OPERATION_TIMEOUT=5s

REFERENCE_POLL_INTERVAL=2s
REFERENCE_RETRY_BACKOFF=5s
REFERENCE_BATCH_SIZE=100

OUTBOX_POLL_INTERVAL=2s
OUTBOX_RETRY_BACKOFF=5s
OUTBOX_MAX_BACKOFF=5m
OUTBOX_BATCH_SIZE=100

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_OUTBOX_QUEUE_NAME=wager-events.fifo

SQS_CONSUMER_QUEUE_NAME=wager-transactions.fifo
SQS_CONSUMER_MAX_MESSAGES=10
SQS_CONSUMER_WAIT_TIME=20s
SQS_CONSUMER_VISIBILITY_TIMEOUT=30s

APPLICATION_SHUTDOWN_TIMEOUT=10s
# OAuth2/OIDC (Keycloak provisioned by docker-compose)
AUTH_ISSUER=http://localhost:8085/realms/jungle
AUTH_JWKS_URL=http://keycloak:8080/realms/jungle/protocol/openid-connect/certs
AUTH_WALLET_CLIENT_ID=wallet-service
AUTH_PROVIDER_CLIENTS=provider-a,provider-b

# Durable pending-reference policy
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_MAX_BACKOFF=5m
REFERENCE_LEASE_DURATION=30s
